<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.nycoagung.foyerlauncher" android:versionCode="2" android:versionName="1.0.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="31" />
    <!-- Only for the weather and Google ambient photos, fetched by the app itself; the page stays offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Android 11+ only shows an app the apps it asks to see: TV apps, normal apps, the TV's own home and its Live TV app. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.cursor.item/channel" />
        </intent>
    </queries>
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner" android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <!-- Not a HOME activity: the TV's own home keeps the Home role. HomeKeyService sends Home here instead. -->
        <activity android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask" android:stateNotNeeded="true"
            android:excludeFromRecents="true" android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|locale|layoutDirection|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".HomeKeyService"
            android:exported="true" android:label="@string/service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_key_service" />
        </service>
    </application>
</manifest>
